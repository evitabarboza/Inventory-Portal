<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="dlgAddEditProduct"
        title="{dialog>/title}"
        contentWidth="500px"
    >
        <content>
            <f:SimpleForm id="editProductForm"
                editable="true"
                layout="ResponsiveGridLayout"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                columnsS="1"
                labelSpanL="4"
                labelSpanM="4"
                emptySpanL="0"
                emptySpanM="0"
            >
                <f:content>
                    <Label
                        text="{i18n>name}"
                        required="true"
                    />
                    <Input
                        id="nameEdit"
                        value="{dialog>/product/name}"
                        liveChange=".onInputChange"
                    />

                    <Label
                        text="{i18n>category}"
                        required="true"
                    />
                    <Input
                        id="categoryEdit"
                        value="{dialog>/product/category}"
                        liveChange=".onInputChange"
                    />

                    <Label
                        text="{i18n>sku}"
                        required="true"
                    />
                    <Input
                        id="skuEdit"
                        value="{dialog>/product/sku}"
                        liveChange=".onInputChange"
                    />

                    <Label
                        text="{i18n>price}"
                        required="true"
                    />
                    <Input
                        id="priceEdit"
                        type="Number"
                        value="{dialog>/product/price}"
                        liveChange=".onInputChange"
                    />

                    <Label
                        text="{i18n>stock}"
                        required="true"
                    />
                    <Input
                        id="stockEdit"
                        type="Number"
                        value="{dialog>/product/stock}"
                        liveChange=".onInputChange"
                    />

                    <Label text="{i18n>reorderthreshold}" />
                    <Input
                        id="reorderEdit"
                        type="Number"
                        value="{dialog>/product/reorderThreshold}"
                    />

                    <Label text="{i18n>supplier}" />
                    <Input
                        id="supplierEdit"
                        value="{dialog>/product/supplier}"
                    />

                    <Label text="{i18n>warehouse}" />
                    <Input
                        id="warehouseEdit"
                        value="{dialog>/product/warehouse}"
                    />

                    <Label text="{i18n>imageurl}" />
                    <Input
                        id="editImage"
                        value="{dialog>/product/imageUrl}"
                        placeholder="https://example.com/image.png"
                    />

                    <Label text="{i18n>description}" />
                    <TextArea
                        id="descriptionEdit"
                        value="{dialog>/product/description}"
                        rows="2"
                    />
                </f:content>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button  id="btnSaveProduct"
                text="Save"
                type="Emphasized"
                press=".onSaveProductDialog"
            />
        </beginButton>

        <endButton>
            <Button id="btnCancelProduct"
                text="Cancel"
                press=".onCancelProductDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
